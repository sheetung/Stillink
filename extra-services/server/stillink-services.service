[Unit]
Description=Stillink extra card services
After=network-online.target

[Service]
WorkingDirectory=%h/Stillink/extra-services/server
ExecStart=%h/.local/bin/uv run --frozen app.py --host 0.0.0.0 --port 8787
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
